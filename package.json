{
    "name": "josemi-icons",
    "version": "0.7.0",
    "description": "An open source and hand-crafted SVG icons library",
    "type": "module",
    "author": "Josemi Juanes <hello@josemi.xyz>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jmjuanes/icons"
    },
    "bugs": "https://github.com/jmjuanes/icons/issues",
    "homepage": "https://icons.josemi.xyz",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./icons.js"
        },
        "./react": {
            "types": "./index.d.ts",
            "import": "./icons.js"
        },
        "./css": {
            "import": "./icons.css"
        },
        "./svg": {
            "import": "./icons.svg"
        },
        "./json": {
            "import": "./icons.json"
        },
        "./schema": {
            "import": "./icons.schema.json"
        }
    },
    "scripts": {
        "build": "yarn build:json && yarn build:react && yarn build:svg && yarn build:css",
        "build:json": "tsx ./scripts/build-json.ts",
        "build:css": "tsx ./scripts/build-css.ts",
        "build:react": "tsx ./scripts/build-react.ts && tsc",
        "build:svg": "tsx ./scripts/build-svg.ts",
        "gallery:build": "mikel --config mikel.config.js",
        "gallery:serve": "serve www -p 3000",
        "test": "jest",
        "pack:icons": "zip -r icons.zip ./icons"
    },
    "optionalDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/clean-css": "^4.2.11",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "clean-css": "^5.3.3",
        "cross-env": "^10.1.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "lowcss": "^0.37.1",
        "mikel": "^0.42.2",
        "mikel-cli": "^0.42.2",
        "mikel-jsx": "^0.42.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "files": [
        "icons",
        "icons.json",
        "icons.schema.json",
        "icons.svg",
        "icons.js",
        "icons.d.ts",
        "icons.css",
        "README.md",
        "package.json"
    ]
}
